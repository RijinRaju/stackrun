# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Without these the app still works; the leaderboard shows "not configured".

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy "service_role" key. SERVER ONLY, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: absolute site URL for share links/OG images (defaults to Vercel's URL).
# NEXT_PUBLIC_SITE_URL=https://stackrun.example.com
